    "prebuild": "node scripts/ensure-standalone-writable.mjs",
    "build": "next build && node scripts/sync-standalone-assets.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "sync:standalone-assets": "node scripts/sync-standalone-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "publish-template": "tsx scripts/publish-template.ts",
    "nuke-saves": "tsx scripts/nuke-saves.ts",
    "import-template": "tsx scripts/import-template-zip.ts",
    "build:demo-shell": "vite build --config vite.demo.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@mashedgames/configurator-engine": "workspace:*",
    "@mashedgames/game-engine": "workspace:*",
    "@mashedgames/shared": "workspace:*",
    "@mashedgames/studio-engine": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.17",
    "@supabase/supabase-js": "^2.107.0",
    "@swc/helpers": "0.5.15",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-bubble-menu": "^3.27.1",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "adm-zip": "^0.5.17",
    "isomorphic-dompurify": "^3.18.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.5",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^10.1.0",
