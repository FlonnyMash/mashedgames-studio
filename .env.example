# Mashed Games Studio — dashboard environment
# Copy to .env.local and fill in real values. Never commit .env.local.
# In dev, apps/dashboard/.env.local is synced from the monorepo-root .env.local
# by scripts/sync-env-local.mjs; keep both copies in step.

# ---------------------------------------------------------------------------
# App mode
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_STUDIO_MODE=true
NEXT_PUBLIC_APP_MODE=studio
NEXT_PUBLIC_ENV=dev
NEXT_PUBLIC_GAME_ENGINE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Supabase (validated by packages/shared/src/env-schema.ts)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable API key (sb_publishable_...) — browser-safe.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Secret API key (sb_secret_...) — server only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx
# Optional PEM JWT signing keys (JWKS is used when omitted).
# SUPABASE_AUTH_PUBLIC_KEY_P256=
# SUPABASE_AUTH_PRIVATE_KEY_P256=

# ---------------------------------------------------------------------------
# Cloudflare Pages (server only)
# One account + token can deploy to multiple Pages projects; the token needs
# the "Cloudflare Pages: Edit" permission. We use TWO separate Pages projects:
#   - CLOUDFLARE_DEMO_PROJECT_NAME   -> Studio editor demos published to the store
#                                       (scripts/deploy-demo.mjs, /api/admin/deploy-demo)
#   - CLOUDFLARE_CLIENT_PROJECT_NAME -> finished customer games for website embed
#                                       (POST /api/projects/[projectId]/deploy)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_scoped_pages_edit_token
CLOUDFLARE_DEMO_PROJECT_NAME=mashedgames-demos
CLOUDFLARE_CLIENT_PROJECT_NAME=mashedgames-clients

# ---------------------------------------------------------------------------
# Workspace / project I/O
# ---------------------------------------------------------------------------
# Absolute path to the workspace root. Falls back to apps/dashboard/.local-workspace
# during `next dev` when unset. In Electron this is injected by the main process.
# MASHEDGAMES_WORKSPACE_PATH=
# Optional projects root override (relative to the dashboard cwd).
PROJECTS_ROOT=../../games
